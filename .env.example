# ───────────── Alex Prime — configuration ─────────────
# Copier vers .env à la racine du projet. Chemins Windows SANS guillemets doubles.

# Serveur HTTP
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Bibliothèque Freebox (lecteur persistant, UNC ou montage CIFS)
# Exemples : Z:\Vidéos | \\mafreebox.freebox.fr\Disque dur\Vidéos | /mnt/freebox/Vidéos
MEDIA_PATH=Z:\Vidéos
MOVIES_DIR=Films
SERIES_DIR=Séries
VIDEO_EXTENSIONS=.mp4,.mkv,.avi,.mov,.m4v,.webm,.ts,.m2ts,.wmv,.mpg

# Données locales (catalog.json + images), relatif à la racine du projet
DATA_DIR=./data

# TMDB : clé API v3 ou jeton de lecture v4 (eyJ...)
TMDB_API_KEY=
TMDB_LANGUAGE=fr-FR

# Sécurité
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_PASSWORD=change-moi-avec-un-mot-de-passe-long
JWT_SECRET=remplacer-par-64-caracteres-hexadecimaux-aleatoires-0123456789abcdef
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
TRUST_PROXY=false
CORS_ORIGIN=

# Scan : auto = disque monté si accessible, sinon API Freebox OS (aucun montage requis) | smb | freebox
SCAN_SOURCE=auto
# Dossiers ignorés (nom exact, toute profondeur, séparés par des virgules)
SCAN_EXCLUDE=
SCAN_ON_START=true
SCAN_INTERVAL_MINUTES=60

# ───────────── Vitrine en ligne (npm run deploy) ─────────────
# Freebox : liens de partage servis directement par la Freebox
FREEBOX_URL=http://mafreebox.freebox.fr
# Identifiant de l'application autorisée sur la Freebox (le changer impose une nouvelle validation sur la box)
FREEBOX_APP_ID=alexprime.app
FREEBOX_MEDIA_ROOT=/Disque dur/Vidéos
FREEBOX_LINK_DAYS=365

# Code PIN du profil (4 à 6 chiffres), demandé hors de la maison, une fois par appareil
VITRINE_PIN=
VITRINE_SESSION_DAYS=365
# IP de la maison = accès sans code (auto = détection au moment du deploy)
HOME_IPS=auto
SITE_URL=

# FTP PulseHeberg (mot de passe entre apostrophes s'il contient # ou espaces)
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=true
FTP_TLS_INSECURE=false
FTP_REMOTE_DIR=/

# FFmpeg (transcodage des formats non natifs : HEVC, AC3/DTS, AVI...)
ENABLE_TRANSCODE=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
